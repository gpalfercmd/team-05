  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action; the teal fill is the single interactive color.",
      "html": "<button class=\"ds-btn-primary\">Verify claim</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;font:inherit;font-size:.875rem;font-weight:500;letter-spacing:.01em;line-height:1.2;border:1.5px solid transparent;border-radius:8px;cursor:pointer;transition:background-color 150ms cubic-bezier(.4,0,.2,1),color 150ms cubic-bezier(.4,0,.2,1);color:var(--color-on-primary);background:var(--color-accent)}.ds-btn-primary:hover{background:color-mix(in srgb,var(--color-accent) 85%,var(--color-on-surface))}.ds-btn-primary:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined alternative action.",
      "html": "<button class=\"ds-btn-secondary\">View evidence</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;font:inherit;font-size:.875rem;font-weight:500;letter-spacing:.01em;line-height:1.2;border:1.5px solid transparent;border-radius:8px;cursor:pointer;transition:background-color 150ms cubic-bezier(.4,0,.2,1),color 150ms cubic-bezier(.4,0,.2,1);color:var(--color-accent);background:transparent;border-color:var(--color-accent)}.ds-btn-secondary:hover{background:color-mix(in srgb,var(--color-accent) 10%,transparent)}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive or rejecting action.",
      "html": "<button class=\"ds-btn-danger\">Reject claim</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;font:inherit;font-size:.875rem;font-weight:500;letter-spacing:.01em;line-height:1.2;border:1.5px solid transparent;border-radius:8px;cursor:pointer;transition:background-color 150ms cubic-bezier(.4,0,.2,1),color 150ms cubic-bezier(.4,0,.2,1);color:var(--color-on-primary);background:var(--color-error)}.ds-btn-danger:hover{background:color-mix(in srgb,var(--color-error) 85%,var(--color-on-surface))}.ds-btn-danger:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label above a hairline input; the global focus ring, no separate focus border.",
      "html": "<div class=\"ds-field\"><label for=\"ds-f1\">Claim reference</label><input id=\"ds-f1\" type=\"text\" placeholder=\"0x...\"><p class=\"ds-hint\">Paste the claim id.</p></div>",
      "css": ".ds-field{display:grid;gap:4px;max-width:320px}.ds-field label{font-size:.875rem;font-weight:600}.ds-field input{padding:10px 12px;font:inherit;color:var(--color-on-surface);background:var(--color-surface);border:1px solid var(--color-border);border-radius:8px}.ds-field input:hover{border-color:var(--color-secondary)}.ds-field input:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}.ds-hint{margin:0;font-size:.75rem;color:var(--color-on-neutral)}"
    },
    {
      "name": "File Drop Zone",
      "kind": "custom",
      "refersTo": "drop-zone",
      "description": "Dashed 12px zone for dropping evidence files.",
      "html": "<div class=\"ds-drop\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 16V4M7 9l5-5 5 5M4 20h16\"/></svg><p>Drop a file to fingerprint it in your browser</p><button class=\"ds-drop-btn\">Choose file</button></div>",
      "css": ".ds-drop{display:grid;justify-items:center;gap:8px;padding:24px 16px;text-align:center;color:var(--color-on-neutral);background:var(--color-neutral);border:2px dashed var(--color-border);border-radius:12px;transition:border-color 150ms cubic-bezier(.4,0,.2,1),background-color 150ms cubic-bezier(.4,0,.2,1)}.ds-drop:hover{border-color:var(--color-accent);background:color-mix(in srgb,var(--color-accent) 8%,var(--color-surface))}.ds-drop svg{color:var(--color-secondary)}.ds-drop p{margin:0}.ds-drop-btn{padding:10px 20px;font:inherit;font-size:.875rem;font-weight:500;color:var(--color-accent);background:transparent;border:1.5px solid var(--color-accent);border-radius:8px;cursor:pointer}.ds-drop-btn:hover{background:color-mix(in srgb,var(--color-accent) 10%,transparent)}.ds-drop-btn:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "status-badge",
      "description": "Pill with icon and label; the label is never omitted.",
      "html": "<span class=\"ds-badge\" tabindex=\"0\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg>Verified</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;padding:2px 10px;font-size:.875rem;font-weight:500;letter-spacing:.01em;line-height:1.5;white-space:nowrap;color:var(--status-verified-fg);background:var(--status-verified-bg);border-radius:9999px}.ds-badge:hover{filter:brightness(.97)}.ds-badge:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "refersTo": "nav-link-active",
      "description": "Sticky header; the active link is a neutral pill with an inset hairline, never underlined.",
      "html": "<header class=\"ds-header\"><a class=\"ds-brand\" href=\"#\">Clear<span class=\"ds-trust\">trust</span></a><nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Claims</a><a href=\"#\">Verify</a><a href=\"#\">Workspace</a></nav></header>",
      "css": ".ds-header{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:64px;padding:12px 24px;background:var(--color-surface);border-bottom:1px solid var(--color-border)}.ds-brand{font-size:1.25rem;font-weight:600;letter-spacing:-.01em;color:var(--color-on-surface);text-decoration:none}.ds-trust{color:#2aa0fc}.ds-nav{display:flex;gap:8px;font-size:.875rem;font-weight:500}.ds-nav a{padding:6px 14px;color:var(--color-primary);text-decoration:none;border-radius:9999px}.ds-nav a:hover,.ds-nav a[aria-current=\"page\"]{background:var(--color-neutral);box-shadow:inset 0 0 0 1px var(--color-border)}.ds-nav a:focus-visible,.ds-brand:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Hash Display",
      "kind": "custom",
      "refersTo": "hash-display",
      "description": "Mono, middle-truncated, copyable.",
      "html": "<span class=\"ds-hash\"><code>0x9f2c4a...7be1d0</code><button class=\"ds-copy\" aria-label=\"Copy hash\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><rect x=\"5\" y=\"5\" width=\"8\" height=\"8\" rx=\"1.5\"/><path d=\"M3 10.5V4a1 1 0 0 1 1-1h6.5\"/></svg></button></span>",
      "css": ".ds-hash{display:inline-flex;align-items:center;gap:4px;max-width:100%}.ds-hash code{font-family:var(--font-mono,\"JetBrains Mono\",monospace);font-size:.8125rem;white-space:nowrap;color:var(--color-on-neutral)}.ds-copy{display:inline-grid;place-items:center;min-width:32px;min-height:32px;padding:4px;color:var(--color-accent);background:transparent;border:0;border-radius:4px;cursor:pointer;transition:background-color 150ms cubic-bezier(.4,0,.2,1)}.ds-copy:hover{background:color-mix(in srgb,var(--color-accent) 10%,transparent)}.ds-copy:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Verification Result",
      "kind": "custom",
      "refersTo": "verification-result",
      "description": "Tinted panel with a 6px left edge in the result color.",
      "html": "<div class=\"ds-result\" tabindex=\"0\"><div class=\"ds-result-head\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 8.5l3.2 3L13 4.5\"/></svg><strong>Match</strong></div><p>The file fingerprint equals the recorded one.</p></div>",
      "css": ".ds-result{--result-color:var(--color-success);display:grid;gap:8px;padding:16px;color:var(--color-on-surface);background:color-mix(in srgb,var(--result-color) 8%,var(--color-surface));border:1px solid color-mix(in srgb,var(--result-color) 40%,var(--color-surface));border-left:6px solid var(--result-color);border-radius:8px}.ds-result:hover{border-color:color-mix(in srgb,var(--result-color) 60%,var(--color-surface));border-left-color:var(--result-color)}.ds-result:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}.ds-result-head{display:flex;align-items:center;gap:8px;font-size:1.25rem}.ds-result-head svg{color:var(--result-color)}.ds-result p{margin:0}"
    },
    {
      "name": "Numbered Timeline",
      "kind": "custom",
      "refersTo": "timeline-marker",
      "description": "Ordered list on a 2px rule; latest step filled teal.",
      "html": "<ol class=\"ds-timeline\"><li tabindex=\"0\">Claim anchored</li><li tabindex=\"0\">Proof submitted</li><li tabindex=\"0\">Verified</li></ol>",
