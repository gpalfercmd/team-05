# Proof of Aid — frontend configuration. Copy to `.env` (never commit `.env`).
# Only VITE_* variables reach the browser: put no private keys or secrets here.
# All values are validated at startup; an invalid value shows a configuration error page.

# Chain the app talks to: `anvil` (local Foundry node, chain id 31337) or `arbitrumSepolia` (421614).
VITE_CHAIN=anvil

# Optional RPC endpoint (http/https). Empty = the chain's public RPC
# (anvil: http://127.0.0.1:8545, Arbitrum Sepolia: https://sepolia-rollup.arbitrum.io/rpc).
VITE_RPC_URL=

# Deployed contract addresses (from code/shared/deployments/ after P2).
# Leave BOTH empty to run on built-in demo data ("Demo data" is shown in the header).
# Setting only one of them is rejected as a half-configured deployment.
VITE_CLAIM_REGISTRY_ADDRESS=
VITE_PARTICIPANT_REGISTRY_ADDRESS=

# Block the ClaimRegistry was deployed in (`deployBlock` in code/shared/deployments/*.json).
# The public claim page reads each claim's history (eth_getLogs) from this block to the latest.
# Empty = 0: always correct, but scans the whole chain (slow on Arbitrum Sepolia).
VITE_DEPLOY_BLOCK=

# Blocks per eth_getLogs request (default 50000). The page halves it on its own when the RPC
# refuses a range; lower it only if your RPC provider needs a very small range.
VITE_LOG_CHUNK_SIZE=

# Optional P4 indexer API base URL (e.g. http://localhost:8000). The public claim page must work without it.
VITE_API_URL=
