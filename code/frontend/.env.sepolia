# Public Arbitrum Sepolia deployment (code/shared/deployments/arbitrum-sepolia.json).
# Contract addresses and block numbers are public data, not secrets — this file is committed on purpose.
# Used by `pnpm dev:sepolia` (Vite mode "sepolia"). Never put private keys here.
VITE_CHAIN=arbitrumSepolia
VITE_CLAIM_REGISTRY_ADDRESS=0x44780Bed68bDd0f9B9a74d82de81B4C069234BFE
VITE_PARTICIPANT_REGISTRY_ADDRESS=0x32a479e9Ad3C0C9e6e00eF2Dff4D7374b6460564
VITE_DEPLOY_BLOCK=312262109

# Optional P4 indexer API (see .env.example). Off by default: the live page must not need a backend.
# Put it in .env.sepolia.local (not committed) or pass it on the command line, e.g.
#   VITE_API_URL=http://localhost:8000 pnpm dev:sepolia
# VITE_API_URL=http://localhost:8000
