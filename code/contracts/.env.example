# Copy to `.env` in this folder (git-ignored); forge loads it automatically.
# Never commit real values, and never put a key or mnemonic that holds real funds here.

# RPC used by `--rpc-url arbitrum_sepolia` (see [rpc_endpoints] in foundry.toml).
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# !!! TEST-ONLY MNEMONIC — NEVER A PERSONAL OR FUNDED MAINNET WALLET !!!
# Create a fresh one with `cast wallet new-mnemonic`. DemoLifecycle.s.sol derives the seven demo
# wallets from it (index 0 deployer/Registry Admin … 6 disputant) and signs every step with them.
# Anyone who reads this value controls all seven wallets.
MNEMONIC=

# Deploy.s.sol: initial role admins. Two DIFFERENT wallets (the constructor rejects the same one).
# For the demo, use the addresses of mnemonic indexes 0 and 1:
#   cast wallet address --mnemonic "$MNEMONIC" --mnemonic-index 0   (Registry Admin)
#   cast wallet address --mnemonic "$MNEMONIC" --mnemonic-index 1   (Accreditation Authority)
REGISTRY_ADMIN=
ACCREDITATION_AUTHORITY=

# DemoLifecycle.s.sol: `true` reuses shared/deployments/<network>.json (anvil.json,
# arbitrum-sepolia.json) instead of deploying.
USE_EXISTING=false
# Optional: replay the story on the same chain with claimId = keccak256(bytes(uuid)). Unset, the
# demo uses the frontend's demo claim (0xfedebf75…), which can be anchored only once per chain.
# DEMO_CLAIM_UUID=

# Optional: Etherscan API v2 key, only for `--verify` on Arbiscan.
ARBISCAN_API_KEY=
