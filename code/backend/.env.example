# PostgreSQL connection. Two options (same URL/localhost:5432):
#   1) Native host service (Omarchy/Arch already runs PostgreSQL on 5432):
#      create role + database once:
#        psql -U postgres -c "CREATE ROLE poa LOGIN PASSWORD 'poa_dev_password'"
#        psql -U postgres -c "CREATE DATABASE proof_of_aid OWNER poa"
#      Do NOT also start docker compose here: it would fight for port 5432.
#   2) Portable path for teammates/CI without host PostgreSQL:
#      `docker compose up -d` (Postgres 16 in docker-compose.yml).
#      If 5432 is taken on that machine, override the host port with POSTGRES_PORT.
DATABASE_URL=postgresql+psycopg://poa:poa_dev_password@localhost:5432/proof_of_aid

# AES-256-GCM key for evidence at rest. 32 random bytes, base64:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Keep it secret; never commit it. Loss makes stored evidence unreadable.
EVIDENCE_ENCRYPTION_KEY=

# Directory where encrypted evidence files are stored (git-ignored).
STORAGE_DIR=./storage

# Random secret for session cookies (wallet-signature login):
#   python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=

# --- P4 (event indexer + public API) — filled in when P2 contracts are deployed ---
# RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# PARTICIPANT_REGISTRY_ADDRESS=
# CLAIM_REGISTRY_ADDRESS=
# START_BLOCK=